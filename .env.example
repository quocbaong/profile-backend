PORT=
APP_ENV=

# Database options:
# 1. Local zero-setup SQLite:
DB_DRIVER=
DB_DSN=

# 2. Production PostgreSQL on Supabase:
# DB_DRIVER=postgres
# DB_DSN=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# JWT Secret (change to strong secret in production)
JWT_SECRET=

# Allowed Frontend Origins (comma separated)
CORS_ORIGIN=

# Default initial admin account (auto-created on first run)
ADMIN_USERNAME=
ADMIN_PASSWORD=


# Supabase Cloud Storage (Upload images directly to Supabase Storage Bucket)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# Email Sending Services (Choose either REST API over Port 443 HTTPS or SMTP):
# Option 1: Resend API over HTTPS Port 443 (Recommended for Render Free tier - https://resend.com)
RESEND_API_KEY=

# Option 2: Brevo API over HTTPS Port 443 (Alternative for Render Free tier - https://brevo.com)
BREVO_API_KEY=

# Option 3: Standard SMTP (Gmail, Brevo SMTP - Note: Render Free blocks ports 587/465)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=
