PORT=8080
APP_ENV=development

# Database options:
# 1. Local zero-setup SQLite:
DB_DRIVER=sqlite
DB_DSN=portfolio.db

# 2. Production PostgreSQL (e.g., Supabase / Neon.tech):
# DB_DRIVER=postgres
# DB_DSN=postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require

# JWT Secret (change to strong secret in production)
JWT_SECRET=super-secret-jwt-key-change-in-production-2026

# Allowed Frontend Origins (comma separated)
CORS_ORIGIN=http://localhost:3000,https://quocbao.click

# Default initial admin account (auto-created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
